{
  "name": "sabakarenuna",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "model:build": "node tools/build-fish.mjs all",
    "model:fish": "node tools/build-fish.mjs fish",
    "model:chef": "node tools/build-fish.mjs chef",
    "check:pages": "node tools/check-pages.mjs",
    "test:pages": "node tests/pages-smoke.mjs",
    "prepare:submission": "npm run build && npm run check:pages",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "test:online": "npm --prefix server test"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
